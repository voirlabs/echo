# --- Database ---
# Postgres connection string. docker compose up -d serves this one.
DATABASE_URL=postgresql://echo:echo@127.0.0.1:5432/echo

# --- Sign-in ---
# Echo has one owner, who signs in with this password: at least 12 characters, e.g.
# openssl rand -base64 18. Without it nobody can sign in.
ADMIN_PASSWORD=
# Signs the session cookie. At least 32 characters: openssl rand -base64 32
# Changing it, or ADMIN_PASSWORD, signs out every device (so does signing out).
SESSION_SECRET=

# --- App ---
# This app's public URL: the OAuth issuer and the MCP server URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: OAuth issuer, only when the app is served from another origin than NEXT_PUBLIC_APP_URL.
OAUTH_ISSUER=
# Reverse proxies in front of the app that append to X-Forwarded-For: 0 for none (the
# default), 1 behind one nginx or Caddy. Rate limits are per address only when it's right.
TRUSTED_PROXY_HOPS=0
# Optional: comma-separated Chrome extension ids allowed to call /api/extension/*.
# Unset, any extension the user installs and grants access to this server may.
EXTENSION_IDS=

# --- Operator ---
# Optional: who runs this instance, shown in the footer.
NEXT_PUBLIC_OPERATOR_NAME=
# Optional: a contact address shown in the footer and error pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional: this instance's terms of service, linked from the footer.
NEXT_PUBLIC_TERMS_URL=
# Optional: this instance's privacy policy, linked from the footer.
NEXT_PUBLIC_PRIVACY_URL=
# Optional: the browser extension's store listing, linked from the app.
NEXT_PUBLIC_EXTENSION_URL=
